    35	    // Process elapsed time first, including when a SAFE arrives at the deadline.
    36	    if (timed_ && now_ >= deadline_) alert(actions);
    37	    const auto result = [&actions](Status status) { return Result{status, actions}; };
    38	    switch (input.kind) {
    39	    case Kind::Tick: return result(Status::Applied);
    40	    case Kind::Connected:
    41	    case Kind::Disconnected:
