class MainActivity : ComponentActivity() {
    private lateinit var collector: PhoneSensorCollector
    private var backgroundStartPending = false
    private lateinit var ownership: SensorOwnership
    private val controller get() = (application as DemoApplication).controller
    private val handler = Handler(Looper.getMainLooper())
    private var sensorSummary by mutableStateOf("Chưa thu cảm biến")
    private val poll = object : Runnable {
        override fun run() {
            if (!controller.backgroundMonitoring) controller.displayPhone(collector.latest())
            handler.postDelayed(this, 250)
        }
    }
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        collector = PhoneSensorCollector(this, controller::acceptPhone)
        ownership = SensorOwnership({ collector.start() }, { collector.stop() })
        setContent {
            MaterialTheme(colorScheme = if (isSystemInDarkTheme()) darkColorScheme() else lightColorScheme()) {
                DemoScreen(controller, sensorSummary, ::startBackground, ::stopBackground)
            }
        }
    }
    override fun onResume() {
        super.onResume()
        controller.foreground = true
        controller.onMonitoringChanged = {
            ownership.update(controller.foreground, controller.backgroundMonitoring)
            sensorSummary = collector.activeSensors.joinToString().ifEmpty { "Không có cảm biến khả dụng" }
        }
        ownership.update(true, controller.backgroundMonitoring)
        sensorSummary = if (controller.backgroundMonitoring) controller.backgroundSensors else collector.activeSensors.joinToString().ifEmpty { "Không có cảm biến khả dụng" }
        controller.resumed()
        handler.post(poll)
        if (backgroundStartPending) { backgroundStartPending = false; beginMonitoring() }
    }
    private fun startBackground() {
        if (Build.VERSION.SDK_INT >= 33 && checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(arrayOf(Manifest.permission.POST_NOTIFICATIONS), 27)
        } else beginMonitoring()
    }
    private fun beginMonitoring() {
        try { startForegroundService(Intent(this, MonitoringService::class.java)) }
        catch (_: RuntimeException) {
            controller.backgroundMessage = "Hệ thống từ chối giám sát nền; vẫn thu khi mở app."
            ownership.update(controller.foreground, controller.backgroundMonitoring)
        }
    }
    override fun onRequestPermissionsResult(requestCode: Int, permissions: Array<String>, grantResults: IntArray) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults)
        if (requestCode == 27) {
            if (grantResults.firstOrNull() == PackageManager.PERMISSION_GRANTED) {
                // Resume after the system permission dialog, never start from a paused Activity.
                if (controller.foreground) beginMonitoring() else backgroundStartPending = true
            } else {
                backgroundStartPending = false
                controller.backgroundMessage = "Chưa bật giám sát nền vì quyền thông báo bị từ chối; cảm biến vẫn dùng khi mở app."
            }
        }
    }
    private fun stopBackground() {
        if (controller.snapshot.state != State.MONITORING) return
        stopService(Intent(this, MonitoringService::class.java))
    }
    override fun onPause() {
        controller.foreground = false
        controller.onMonitoringChanged = null
        ownership.update(false, controller.backgroundMonitoring)
        handler.removeCallbacks(poll)
        controller.paused()
        super.onPause()
    }
}

@Composable
private fun DemoScreen(c: DemoController, sensorSummary: String, startBackground: () -> Unit, stopBackground: () -> Unit) {
    var tab by rememberSaveable { mutableIntStateOf(0) }
    val tabs = listOf("Trang chủ", "Sự kiện", "Người thân", "Cài đặt")
    val scrollState = rememberScrollState()
    LaunchedEffect(tab, c.snapshot.state) { scrollState.scrollTo(0) }
    Scaffold(bottomBar = {
        NavigationBar {
            tabs.forEachIndexed { i, title ->
                NavigationBarItem(selected = tab == i, onClick = { tab = i },
                    icon = { Text(listOf("⌂", "≡", "♡", "⚙")[i]) }, label = { Text(title) })
            }
        }
    }) { inset ->
        Column(Modifier.fillMaxSize().padding(inset).verticalScroll(scrollState)
            .padding(16.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {
            Text("THỬ NGHIỆM — không gửi ra ngoài", fontSize = 22.sp,
                color = MaterialTheme.colorScheme.error)
            Text(c.source, style = MaterialTheme.typography.titleMedium)
            // Verification remains accessible from every tab, with no blocking modal.
            if (c.snapshot.state == State.VERIFYING) {
                Text("! Bạn có ổn không?", style = MaterialTheme.typography.headlineMedium)
                Text("Còn ${((c.snapshot.remainingMs ?: 0) + 999) / 1000} giây",
                    fontSize = 32.sp, modifier = Modifier.semantics { liveRegion = LiveRegionMode.Polite })
                Action("TÔI VẪN ỔN", c::safe)
                Action("CẦN GIÚP ĐỠ", c::help)
            }
            when (tab) {
                0 -> {
                    Text(stateLabel(c), style = MaterialTheme.typography.headlineSmall)
                    Text("BLE: chưa tích hợp • PHONE_ONLY vẫn dùng được")
                    Text(if (c.packet == null) "! Thiếu hoặc cũ dữ liệu; không thể đánh giá nguy cơ."
                        else "Có mẫu gia tốc • chưa thể kết luận an toàn.")
                    Text("Mang theo người: UNKNOWN — chưa có thuật toán xác định.")
                    Text("Vị trí: chưa lấy vị trí; không chờ GPS.")
                    if (c.foreground) SosButton(c::sos)
                    Action("Chạy dữ liệu mô phỏng", c::runReplay,
                        c.snapshot.state == State.MONITORING && !c.replaying)
                    if (c.replaying) Text("Đang cấp chuỗi va đập rồi yên mô phỏng…")
                    Action("Dùng cảm biến điện thoại", c::usePhone, c.snapshot.state == State.MONITORING)
                    if (c.snapshot.state == State.ALERTING || c.snapshot.state == State.AWAITING_HELP) {
                        Text("Người nhận: Người thân mô phỏng 1 • kênh: bộ nhớ tại máy")
                        Text(if (c.snapshot.status == Status.SENT) "Đã nhận GIẢ tại sink; không phải người thật xác nhận."
                            else "Gửi GIẢ thất bại; không tự gửi lại.")
                        Action("Hoàn tất sự kiện để thử lại", c::complete)
                    }
                }
                1 -> {
                    Text("Sự kiện thử nghiệm", style = MaterialTheme.typography.headlineSmall)
                    Text("32 chuyển trạng thái gần nhất trong phiên; ID không lưu qua khởi động lại. Độ tin cậy: chưa đánh giá.")
                    if (c.events.isEmpty()) Text("Chưa có sự kiện.")
                    c.events.asReversed().forEach {
                        Text("#${it.eventId} • ${it.state}\n${statusLabel(it.status)}")
                    }
                }
                2 -> {
                    Text("Người thân mô phỏng", style = MaterialTheme.typography.headlineSmall)
                    Text("Ưu tiên 1 • Người thân mô phỏng 1\nKênh nhận: bộ nhớ tại máy; không số điện thoại, không danh bạ thật.")
                    Text("Sink đã nhận ${c.session.sink.alerts().size} cảnh báo giả (tối đa 32).")
                    Text("Không SMS, cuộc gọi hoặc liên lạc mạng.")
                }
                3 -> {
                    Text("Kiểm tra hệ thống", style = MaterialTheme.typography.headlineSmall)
                    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
                        Text("Giả lập lỗi gửi", Modifier.weight(1f), fontSize = 20.sp)
                        Switch(c.fail, c::setFailure, Modifier.semantics { contentDescription = "Giả lập lỗi gửi" })
                    }
                    Text(c.backgroundMessage)
                    Action("Bật giám sát nền thử", startBackground, !c.backgroundMonitoring)
                    Action("Dừng giám sát nền thử", stopBackground, c.backgroundMonitoring && c.snapshot.state == State.MONITORING)
                    Text("Dừng trong app chỉ khi không có sự kiện đang xử lý. Android có thể dừng process; không tự khởi động lại.")
                    Text("Đã đăng ký: ${if (c.backgroundMonitoring) c.backgroundSensors else sensorSummary}")
                    val p = c.packet
                    Text("Gia tốc m/s²: ${p?.let { "${it.accelXMs2}, ${it.accelYMs2}, ${it.accelZMs2}" } ?: "không có / quá 500 ms"}")
                    Text("Gyro °/s: ${p?.gyroXDps ?: "—"}, ${p?.gyroYDps ?: "—"}, ${p?.gyroZDps ?: "—"}")
                    Text("Pitch/roll/yaw °: ${p?.pitchDeg ?: "—"}, ${p?.rollDeg ?: "—"}, ${p?.yawDeg ?: "—"}")
                    Text("Áp suất Pa: ${p?.pressurePa ?: "—"}; gia tốc tuyến tính: ${p?.linearAccelXMs2 ?: "—"}, ${p?.linearAccelYMs2 ?: "—"}, ${p?.linearAccelZMs2 ?: "—"}")
                    Text("— = thiếu/cũ dữ liệu. Chất lượng chưa chấm điểm (0). Bước chân, độ cao, vị trí, pin, rung/âm thanh và màn hình khóa chưa tích hợp.")
                    Text("Luật DEMO: va đập ≥25 m/s² rồi yên ≥1 giây trong cửa sổ 3 giây; chưa kiểm chứng độ chính xác phát hiện ngã.")
                    Text("Thu cảm biến khi app mở hoặc khi bạn bật giám sát nền thử. Service có thông báo; giữ CPU tối đa11giây lúc xác minh. Không tự phục hồi khi process chết; pin và điện thoại thật chưa kiểm chứng.")
                }
            }
        }
    }
}
@Composable
private fun Action(label: String, action: () -> Unit, enabled: Boolean = true) {
    Button(onClick = action, enabled = enabled, modifier = Modifier.fillMaxWidth().heightIn(min = 56.dp)) {
        Text(label, fontSize = 20.sp)
    }
}
@Composable
private fun SosButton(onSos: () -> Unit) {
    val currentAction by rememberUpdatedState(onSos)
    val hold = remember { SosHold() }
    val handler = remember { Handler(Looper.getMainLooper()) }
    var holding by remember { mutableStateOf(false) }
    var accessibleArmed by remember { mutableStateOf(false) }
    val fire = remember { Runnable {
        if (hold.ready(SystemClock.elapsedRealtime())) {
            holding = false; accessibleArmed = false; currentAction()
        }
    } }
    DisposableEffect(Unit) {
        onDispose { handler.removeCallbacks(fire); hold.cancel() }
    }
    Box(Modifier.fillMaxWidth().heightIn(min = 80.dp)
        .background(MaterialTheme.colorScheme.errorContainer)
        .semantics {
            role = Role.Button
            contentDescription = "SOS giữ 2 giây. Với TalkBack, kích hoạt để bắt đầu, kích hoạt lần nữa để hủy."
            onClick {
                if (accessibleArmed) { hold.cancel(); handler.removeCallbacks(fire); accessibleArmed = false; holding = false }
                else { accessibleArmed = true; holding = true; hold.start(SystemClock.elapsedRealtime()); handler.postDelayed(fire, 2000) }
                true
            }
        }
        .pointerInput(Unit) {
            detectTapGestures(onPress = {
                holding = true
                hold.start(SystemClock.elapsedRealtime())
                handler.postDelayed(fire, 2000)
                try { tryAwaitRelease() } finally {
                    handler.removeCallbacks(fire); hold.cancel(); holding = false
                }
            })
        }.padding(20.dp)) {
        Text(if (holding) "Đang giữ SOS…" else "SOS — GIỮ 2 GIÂY", fontSize = 24.sp,
            color = MaterialTheme.colorScheme.onErrorContainer)
    }
}
private fun statusLabel(status: Status): String = when (status) {
    Status.NOT_REQUIRED -> "Chưa yêu cầu gửi"
    Status.COUNTDOWN -> "Đang đếm ngược"
    Status.SENDING -> "Đang gửi GIẢ"
    Status.SENT -> "Đã gửi THỬ NGHIỆM"
    Status.FAILED -> "Gửi GIẢ thất bại"
    Status.ACKNOWLEDGED -> "Đã hoàn tất tại máy (không phải biên nhận)"
}
private fun stateLabel(c: DemoController): String = when (c.snapshot.state) {
    State.MONITORING -> if (c.snapshot.status == Status.ACKNOWLEDGED) "✓ Đã hoàn tất sự kiện" else "○ Theo dõi thử nghiệm"
    State.SUSPECTED -> "! Cần chú ý"
    State.VERIFYING -> "! Đang xác minh"
    State.ALERTING, State.AWAITING_HELP -> statusLabel(c.snapshot.status)
}

