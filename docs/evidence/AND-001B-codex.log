@Composable
private fun Action(label: String, action: () -> Unit, enabled: Boolean = true) {
    Button(onClick = action, enabled = enabled, modifier = Modifier.fillMaxWidth().heightIn(min = 56.dp)) {
        Text(label, fontSize = 20.sp)
    }
}
@Composable
private fun SosButton(onSos: () -> Unit) {
    val currentAction by rememberUpdatedState(onSos)
    val hold = remember { SosHold() }
    val handler = remember { Handler(Looper.getMainLooper()) }
    var holding by remember { mutableStateOf(false) }
    var accessibleArmed by remember { mutableStateOf(false) }
    val fire = remember { Runnable {
        if (hold.ready(SystemClock.elapsedRealtime())) {
            holding = false; accessibleArmed = false; currentAction()
        }
    } }
    DisposableEffect(Unit) {
        onDispose { handler.removeCallbacks(fire); hold.cancel() }
    }
    Box(Modifier.fillMaxWidth().heightIn(min = 80.dp)
        .background(MaterialTheme.colorScheme.errorContainer)
        .semantics {
            role = Role.Button
            contentDescription = "SOS giữ 2 giây. Với TalkBack, kích hoạt để bắt đầu, kích hoạt lần nữa để hủy."
            onClick {
                if (accessibleArmed) { hold.cancel(); handler.removeCallbacks(fire); accessibleArmed = false; holding = false }
                else { accessibleArmed = true; holding = true; hold.start(SystemClock.elapsedRealtime()); handler.postDelayed(fire, 2000) }
                true
            }
        }
        .pointerInput(Unit) {
            detectTapGestures(onPress = {
                holding = true
                hold.start(SystemClock.elapsedRealtime())
                handler.postDelayed(fire, 2000)
                try { tryAwaitRelease() } finally {
                    handler.removeCallbacks(fire); hold.cancel(); holding = false
                }
            })
        }.padding(20.dp)) {
        Text(if (holding) "Đang giữ SOS…" else "SOS — GIỮ 2 GIÂY", fontSize = 24.sp,
            color = MaterialTheme.colorScheme.onErrorContainer)
    }
}
private fun statusLabel(status: Status): String = when (status) {
    Status.NOT_REQUIRED -> "Chưa yêu cầu gửi"
    Status.COUNTDOWN -> "Đang đếm ngược"
    Status.SENDING -> "Đang gửi GIẢ"
    Status.SENT -> "Đã gửi THỬ NGHIỆM"
    Status.FAILED -> "Gửi GIẢ thất bại"
    Status.ACKNOWLEDGED -> "Đã hoàn tất tại máy (không phải biên nhận)"
}
private fun stateLabel(c: DemoController): String = when (c.snapshot.state) {
    State.MONITORING -> if (c.snapshot.status == Status.ACKNOWLEDGED) "✓ Đã hoàn tất sự kiện" else "○ Theo dõi thử nghiệm"
    State.SUSPECTED -> "! Cần chú ý"
    State.VERIFYING -> "! Đang xác minh"
    State.ALERTING, State.AWAITING_HELP -> statusLabel(c.snapshot.status)
}
