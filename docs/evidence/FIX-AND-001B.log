                        else "Có mẫu gia tốc • chưa thể kết luận an toàn.")
                    Text("Mang theo người: UNKNOWN — chưa có thuật toán xác định.")
                    Text("Vị trí: chưa lấy vị trí; không chờ GPS.")
                    if (c.foreground) SosButton(c::sos)
                    Action("Chạy dữ liệu mô phỏng", c::runReplay,
                        c.snapshot.state == State.MONITORING && !c.replaying)
                    if (c.replaying) Text("Đang cấp chuỗi va đập rồi yên mô phỏng…")
                    Action("Dùng cảm biến điện thoại", c::usePhone, c.snapshot.state == State.MONITORING)
                    if (c.snapshot.state == State.ALERTING || c.snapshot.state == State.AWAITING_HELP) {
                        Text("Người nhận: Người thân mô phỏng 1 • kênh: bộ nhớ tại máy")
                        Text(if (c.snapshot.status == Status.SENT) "Đã nhận GIẢ tại sink; không phải người thật xác nhận."
                            else "Gửi GIẢ thất bại; không tự gửi lại.")
                        Action("Hoàn tất sự kiện để thử lại", c::complete)
                    }
                }
                1 -> {
                    Text("Sự kiện thử nghiệm", style = MaterialTheme.typography.headlineSmall)
                    Text("32 chuyển trạng thái gần nhất trong phiên; ID không lưu qua khởi động lại. Độ tin cậy: chưa đánh giá.")
                    if (c.events.isEmpty()) Text("Chưa có sự kiện.")
                    c.events.asReversed().forEach {
                        Text("#${it.eventId} • ${it.state}\n${statusLabel(it.status)}")
                    }

