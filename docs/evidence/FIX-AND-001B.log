        NavigationBar {
            tabs.forEachIndexed { i, title ->
                NavigationBarItem(selected = tab == i, onClick = { tab = i },
                    icon = { Text(listOf("⌂", "≡", "♡", "⚙")[i]) }, label = { Text(title) })
            }
        }
