        now++
        session.tick()
        assertEquals(Response.NO_RESPONSE, session.snapshot().response)
        assertEquals(Status.SENT, session.snapshot().status)
        assertEquals(1, sink.alerts().size)
        session.tick()
        assertEquals(1, sink.alerts().size)
    }
    @Test fun safeFailureCompleteAndBoundedHistory() {
