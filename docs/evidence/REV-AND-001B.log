     3	import android.content.Context
     4	import android.hardware.Sensor
     5	import android.hardware.SensorEvent
     6	import android.hardware.SensorEventListener
     7	import android.hardware.SensorManager
     8	import android.os.Handler
     9	import android.os.Looper
    10	import android.os.SystemClock
    11	
    12	/** Activity starts/stops collection; all callbacks are confined to main looper. */
    13	class PhoneSensorCollector(context: Context, private val onPacket: (PhoneSensorPacket) -> Unit) : SensorEventListener {
    14	    private val manager = context.getSystemService(Context.SENSOR_SERVICE) as SensorManager
    15	    private val normalizer = PhoneNormalizer()
    16	    private val kinds = mapOf(
    17	        Sensor.TYPE_ACCELEROMETER to SensorKind.ACCEL,
    18	        Sensor.TYPE_LINEAR_ACCELERATION to SensorKind.LINEAR,
    19	        Sensor.TYPE_GYROSCOPE to SensorKind.GYRO,
    20	        Sensor.TYPE_ROTATION_VECTOR to SensorKind.ORIENTATION,
    21	        Sensor.TYPE_PRESSURE to SensorKind.PRESSURE
    22	    )
    23	    var activeSensors: Set<SensorKind> = emptySet(); private set
    24	    private var running = false
    25	    fun start() {
    26	        stop()
    27	        running = true
    28	        activeSensors = kinds.mapNotNull { (type, kind) ->
    29	            val sensor = manager.getDefaultSensor(type) ?: return@mapNotNull null
    30	            val registered = try {
    31	                manager.registerListener(this, sensor, SensorManager.SENSOR_DELAY_GAME, Handler(Looper.getMainLooper()))
    32	            } catch (_: SecurityException) { false }
    33	            if (registered) kind else null
    34	        }.toSet()
    35	    }
    36	    fun stop() {
    37	        running = false
    38	        manager.unregisterListener(this)
    39	        normalizer.clear()
    40	        activeSensors = emptySet()
    41	    }
    42	    fun latest(): PhoneSensorPacket? = normalizer.packet(SystemClock.elapsedRealtimeNanos(), System.currentTimeMillis())
    43	    override fun onSensorChanged(event: SensorEvent) {
    44	        if (!running) return
    45	        val kind = kinds[event.sensor.type] ?: return
    46	        if (kind == SensorKind.ORIENTATION) {
    47	            if (event.values.size < 3 || event.values.any { !it.isFinite() }) {
    48	                normalizer.update(kind, event.timestamp, floatArrayOf(Float.NaN)); return
    49	            }
    50	            val rotation = FloatArray(9)
    51	            val orientation = FloatArray(3)
    52	            SensorManager.getRotationMatrixFromVector(rotation, event.values)
    53	            SensorManager.getOrientation(rotation, orientation)
    54	            normalizer.update(kind, event.timestamp, floatArrayOf(
    55	                Math.toDegrees(orientation[1].toDouble()).toFloat(),
    56	                Math.toDegrees(orientation[2].toDouble()).toFloat(),
    57	                Math.toDegrees(orientation[0].toDouble()).toFloat()
    58	            ))
    59	        } else normalizer.update(kind, event.timestamp, event.values)
    60	        if (kind == SensorKind.ACCEL) latest()?.let(onPacket)
    61	    }
    62	    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) = Unit
    63	}

