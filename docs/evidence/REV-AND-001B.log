    45	    }
    46	    override fun onResume() {
    47	        super.onResume()
    48	        controller.foreground = true
    49	        collector.start()
    50	        sensorSummary = collector.activeSensors.joinToString().ifEmpty { "Không có cảm biến khả dụng" }
    51	        controller.resumed()
    52	        handler.post(poll)
    53	    }
    54	    override fun onPause() {
    55	        controller.foreground = false
    56	        collector.stop()
    57	        handler.removeCallbacks(poll)
    58	        controller.displayPhone(null)
    59	        controller.session.resetDetection()
    60	        super.onPause()
    61	    }
    62	}
