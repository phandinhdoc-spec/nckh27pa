   149	@Composable
   150	private fun SosButton(onSos: () -> Unit) {
   151	    val currentAction by rememberUpdatedState(onSos)
   152	    val hold = remember { SosHold() }
   153	    val handler = remember { Handler(Looper.getMainLooper()) }
   154	    var holding by remember { mutableStateOf(false) }
   155	    var accessibleArmed by remember { mutableStateOf(false) }
   156	    val fire = remember { Runnable {
   157	        if (hold.ready(SystemClock.elapsedRealtime())) {
   158	            holding = false; accessibleArmed = false; currentAction()
   159	        }
   160	    } }
   161	    DisposableEffect(Unit) {
   162	        onDispose { handler.removeCallbacks(fire); hold.cancel() }
   163	    }
   164	    Box(Modifier.fillMaxWidth().heightIn(min = 80.dp)
   165	        .background(MaterialTheme.colorScheme.errorContainer)
   166	        .semantics {
   167	            role = Role.Button
   168	            contentDescription = "SOS giữ 2 giây. Với TalkBack, kích hoạt để bắt đầu, kích hoạt lần nữa để hủy."
   169	            onClick {
   170	                if (accessibleArmed) { hold.cancel(); handler.removeCallbacks(fire); accessibleArmed = false; holding = false }
   171	                else { accessibleArmed = true; holding = true; hold.start(SystemClock.elapsedRealtime()); handler.postDelayed(fire, 2000) }
   172	                true
   173	            }
   174	        }
   175	        .pointerInput(Unit) {
   176	            detectTapGestures(onPress = {
   177	                holding = true
   178	                hold.start(SystemClock.elapsedRealtime())
   179	                handler.postDelayed(fire, 2000)
   180	                try { tryAwaitRelease() } finally {
   181	                    handler.removeCallbacks(fire); hold.cancel(); holding = false
   182	                }
   183	            })
   184	        }.padding(20.dp)) {
   185	        Text(if (holding) "Đang giữ SOS…" else "SOS — GIỮ 2 GIÂY", fontSize = 24.sp,
   186	            color = MaterialTheme.colorScheme.onErrorContainer)
   187	    }
   188	}
   189	private fun statusLabel(status: Status): String = when (status) {
   190	    Status.NOT_REQUIRED -> "Chưa yêu cầu gửi"
   191	    Status.COUNTDOWN -> "Đang đếm ngược"
   192	    Status.SENDING -> "Đang gửi GIẢ"
   193	    Status.SENT -> "Đã gửi THỬ NGHIỆM"
   194	    Status.FAILED -> "Gửi GIẢ thất bại"
   195	    Status.ACKNOWLEDGED -> "Đã hoàn tất tại máy (không phải biên nhận)"
   196	}
   197	private fun stateLabel(c: DemoController): String = when (c.snapshot.state) {
   198	    State.MONITORING -> if (c.snapshot.status == Status.ACKNOWLEDGED) "✓ Đã hoàn tất sự kiện" else "○ Theo dõi thử nghiệm"
   199	    State.SUSPECTED -> "! Cần chú ý"
   200	    State.VERIFYING -> "! Đang xác minh"
   201	    State.ALERTING, State.AWAITING_HELP -> statusLabel(c.snapshot.status)
   202	}
     1	package core
     2	
     3	/** Nondecreasing elapsed milliseconds, never civil/wall time. */
     4	fun interface MonotonicClock { fun nowMs(): Long }
     5	
     6	/** Synchronous acceptance: return means SENT; throw Exception means FAILED. */
     7	fun interface AlertSink { fun send(alert: Alert) }
     8	
     9	enum class State { MONITORING, SUSPECTED, VERIFYING, ALERTING, AWAITING_HELP }
    10	enum class Response { UNKNOWN, SAFE, NEED_HELP, NO_RESPONSE }
    11	enum class Status { NOT_REQUIRED, COUNTDOWN, SENDING, SENT, FAILED, ACKNOWLEDGED }
    12	data class Alert(
    13	    val eventId: Long,
    14	    val response: Response,
    15	    val locationMessage: String = "chưa xác định được vị trí"
    16	)
    17	data class Snapshot(
    18	    val state: State,
    19	    val eventId: Long,
    20	    val response: Response,
    21	    val status: Status,
    22	    val remainingMs: Long?
    23	)
    24	data class RecordedEvent(val eventId: Long, val state: State, val status: Status)
    25	
    26	/**
    27	 * Confined to the creating thread, including reads and sink callbacks.
    28	 * Host must call tick at the deadline; this core does not schedule background work.
    29	 * Calls reentering from the synchronous sink cannot finish or resend the active event.
    30	 */
    31	class AlertCore(
    32	    private val clock: MonotonicClock,
    33	    private val sink: AlertSink,
    34	    private val timeoutMs: Long = 10_000,
    35	    private val logCapacity: Int = 32
    36	) {
    37	    init {
    38	        require(timeoutMs > 0) { "timeoutMs must be positive" }
    39	        require(logCapacity > 0) { "logCapacity must be positive" }
    40	    }
    41	
    42	    private val owner = Thread.currentThread()
    43	    private var state = State.MONITORING
    44	    private var eventId = 0L
    45	    private var response = Response.UNKNOWN
    46	    private var status = Status.NOT_REQUIRED
    47	    private var started = 0L
    48	    private var sending = false
    49	    private val log = ArrayDeque<RecordedEvent>()
    50	
    51	    private fun owned() {
    52	        check(Thread.currentThread() === owner) { "Call on owner thread" }
    53	    }
    54	
    55	    /** Display-only read; never sends an alert. */
    56	    fun snapshot(): Snapshot {
    57	        owned()
    58	        val remaining = if (state == State.VERIFYING)
    59	            (timeoutMs - (clock.nowMs() - started)).coerceAtLeast(0) else null
    60	        return Snapshot(state, eventId, response, status, remaining)
    61	    }
    62	
    63	    fun events(): List<RecordedEvent> {
    64	        owned()
    65	        return log.toList()
    66	    }
    67	
    68	    private fun record() {
    69	        log.addLast(RecordedEvent(eventId, state, status))
    70	        while (log.size > logCapacity) log.removeFirst()
    71	    }
    72	
    73	    fun suspected() {
    74	        owned()
    75	        if (state == State.MONITORING) {
    76	            eventId++
    77	            response = Response.UNKNOWN
    78	            status = Status.NOT_REQUIRED
    79	            state = State.SUSPECTED
    80	            record()
    81	        }
    82	    }
    83	
    84	    fun evidenceConfirmed() {
    85	        owned()
    86	        if (state == State.SUSPECTED) {
    87	            started = clock.nowMs()
    88	            state = State.VERIFYING
    89	            status = Status.COUNTDOWN
    90	            record()
    91	        }
    92	    }
    93	
    94	    fun riskCleared() {
    95	        owned()
    96	        if (state == State.SUSPECTED) {
    97	            state = State.MONITORING
    98	            record()
    99	        }
   100	    }
   101	
   102	    private fun dispatch(reason: Response) {
   103	        if (state == State.ALERTING || state == State.AWAITING_HELP) return
   104	        if (state == State.MONITORING) eventId++
   105	        response = reason
   106	        state = State.ALERTING
   107	        status = Status.SENDING
   108	        record()
   109	        // Set both state and guard before invoking external code.
   110	        sending = true
   111	        try {
   112	            sink.send(Alert(eventId, reason))
   113	            status = Status.SENT
   114	            state = State.AWAITING_HELP
   115	        } catch (_: Exception) {
   116	            // Never retain transport messages, which may contain private data.
   117	            status = Status.FAILED
   118	        } finally {
   119	            sending = false
   120	        }
   121	        record()
   122	    }
   123	
   124	    fun tick() {
   125	        owned()
   126	        if (state == State.VERIFYING && clock.nowMs() - started >= timeoutMs)
   127	            dispatch(Response.NO_RESPONSE)
   128	    }
   129	
   130	    fun safe() {
   131	        owned()
   132	        tick()
   133	        if (state == State.VERIFYING || state == State.SUSPECTED) {
   134	            response = Response.SAFE
   135	            status = Status.NOT_REQUIRED
   136	            state = State.MONITORING
   137	            record()
   138	        }
   139	    }
   140	
   141	    fun needHelp() {
   142	        owned()
   143	        dispatch(Response.NEED_HELP)
   144	    }
   145	
   146	    fun sos() {
   147	        owned()
   148	        dispatch(Response.NEED_HELP)
   149	    }
   150	
   151	    fun complete() {
   152	        owned()
   153	        if (!sending && (state == State.AWAITING_HELP || state == State.ALERTING)) {
   154	            state = State.MONITORING
   155	            status = Status.ACKNOWLEDGED
   156	            record()
   157	        }
   158	    }
   159	}
