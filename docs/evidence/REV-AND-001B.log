    13	/** Process-scoped session survives Activity recreation. No foreground service. */
    14	class DemoApplication : Application() {
    15	    lateinit var controller: DemoController; private set
    16	    override fun onCreate() { super.onCreate(); controller = DemoController() }
    17	}
    18	class DemoController {
    19	    var foreground by mutableStateOf(false)
    20	    val session = DemoSession(MonotonicClock { SystemClock.elapsedRealtime() })
    21	    var snapshot by mutableStateOf(session.snapshot()); private set
    22	    var events by mutableStateOf(session.events()); private set
    23	    var source by mutableStateOf("PHONE_ONLY • cảm biến thật"); private set
    24	    var packet by mutableStateOf<PhoneSensorPacket?>(null); private set
    25	    var replaying by mutableStateOf(false); private set
    26	    var fail by mutableStateOf(false); private set
    27	    private var replay: DemoReplay? = null
    28	    private val handler = Handler(Looper.getMainLooper())
    29	    private val tick = object : Runnable {
    30	        override fun run() {
    31	            val now = SystemClock.elapsedRealtime()
    32	            replay?.let { r ->
    33	                r.due(now).forEach { packet = it; session.accept(it) }
    34	                if (r.finished) { replay = null; replaying = false }
    35	            }
    36	            session.tick()
    37	            refresh()
    38	            if (replay != null || snapshot.state == State.VERIFYING) handler.postDelayed(this, 50)
    39	        }
    40	    }
    41	    fun refresh() { snapshot = session.snapshot(); events = session.events() }
    42	    private fun schedule() { handler.removeCallbacks(tick); handler.post(tick) }
    43	    fun acceptPhone(p: PhoneSensorPacket) {
    44	        if (!source.startsWith("PHONE_ONLY")) return
    45	        packet = p
    46	        session.accept(p)
    47	        refresh()
    48	        if (snapshot.state == State.VERIFYING) schedule()
    49	    }
    50	    fun displayPhone(p: PhoneSensorPacket?) {
    51	        if (source.startsWith("PHONE_ONLY")) packet = p
    52	    }
    53	    fun runReplay() {
    54	        if (snapshot.state != State.MONITORING || replaying) return
    55	        source = "MÔ PHỎNG • dữ liệu giả"
    56	        session.resetDetection()
    57	        packet = null
    58	        replay = DemoReplay(SystemClock.elapsedRealtime())
    59	        replaying = true
    60	        schedule()
    61	    }
    62	    fun usePhone() {
    63	        if (snapshot.state != State.MONITORING) return
    64	        replay = null; replaying = false; packet = null
    65	        source = "PHONE_ONLY • cảm biến thật"
    66	        session.resetDetection()
    67	    }
    68	    fun safe() { session.safe(); refresh() }
    69	    fun sos() { if (foreground) help() }
    70	    fun help() { session.needHelp(); refresh() }
    71	    fun complete() { replay = null; replaying = false; session.complete(); refresh() }
    72	    fun setFailure(value: Boolean) { fail = value; session.sink.fail = value }
    73	    fun resumed() { session.tick(); refresh(); schedule() }
    74	}
