    26	class MainActivity : ComponentActivity() {
    27	    private lateinit var collector: PhoneSensorCollector
    28	    private val controller get() = (application as DemoApplication).controller
    29	    private val handler = Handler(Looper.getMainLooper())
    30	    private var sensorSummary by mutableStateOf("Chưa thu cảm biến")
    31	    private val poll = object : Runnable {
    32	        override fun run() {
    33	            controller.displayPhone(collector.latest())
    34	            handler.postDelayed(this, 250)
    35	        }
    36	    }
    37	    override fun onCreate(savedInstanceState: Bundle?) {
