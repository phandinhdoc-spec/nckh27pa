     7	/** Names/types follow plan §4.5.2. Confidence 0 + UNKNOWN means unestimated. */
     8	data class PhoneSensorPacket(
     9	    val timestampNs: Long, val wallClockTimestampMs: Long,
    10	    val accelXMs2: Float, val accelYMs2: Float, val accelZMs2: Float,
    11	    val linearAccelXMs2: Float? = null, val linearAccelYMs2: Float? = null,
    12	    val linearAccelZMs2: Float? = null,
    13	    val gyroXDps: Float? = null, val gyroYDps: Float? = null, val gyroZDps: Float? = null,
    14	    val pitchDeg: Float? = null, val rollDeg: Float? = null, val yawDeg: Float? = null,
    15	    val pressurePa: Float? = null, val altitudeDeltaM: Float? = null,
    16	    val stepCount: Long? = null, val stepDetected: Boolean? = null,
    17	    val phoneMotionState: String = "UNKNOWN", val phonePlacementConfidence: Int = 0,
    18	    val sensorQuality: Int = 0
    19	)
    20	enum class SensorKind { ACCEL, LINEAR, GYRO, ORIENTATION, PRESSURE }
    21	class PhoneNormalizer {
    22	    private data class Reading(val ns: Long, val values: List<Float>)
    23	    private val readings = mutableMapOf<SensorKind, Reading>()
    24	    fun clear() = readings.clear()
    25	    fun update(kind: SensorKind, ns: Long, values: FloatArray) {
    26	        val count = if (kind == SensorKind.PRESSURE) 1 else 3
    27	        if (ns < 0 || values.size < count || values.take(count).any { !it.isFinite() } ||
    28	            (kind == SensorKind.PRESSURE && values[0] <= 0f)) {
    29	            readings.remove(kind); return
    30	        }
    31	        if (ns < (readings[kind]?.ns ?: -1)) return
    32	        val scale = when (kind) {
    33	            SensorKind.GYRO -> (180.0 / Math.PI).toFloat()
    34	            SensorKind.PRESSURE -> 100f
    35	            else -> 1f
    36	        }
    37	        val converted = values.take(count).map { it * scale }
    38	        if (converted.any { !it.isFinite() }) { readings.remove(kind); return }
    39	        readings[kind] = Reading(ns, converted)
    40	    }
    41	    fun packet(nowNs: Long, wallMs: Long): PhoneSensorPacket? {
    42	        fun fresh(kind: SensorKind) = readings[kind]?.takeIf {
    43	            nowNs >= it.ns && nowNs - it.ns <= 500_000_000
    44	        }
    45	        val a = fresh(SensorKind.ACCEL) ?: return null
    46	        val l = fresh(SensorKind.LINEAR)?.values
    47	        val g = fresh(SensorKind.GYRO)?.values
    48	        val o = fresh(SensorKind.ORIENTATION)?.values
    49	        return PhoneSensorPacket(a.ns, wallMs, a.values[0], a.values[1], a.values[2],
    50	            l?.get(0), l?.get(1), l?.get(2), g?.get(0), g?.get(1), g?.get(2),
    51	            o?.get(0), o?.get(1), o?.get(2), fresh(SensorKind.PRESSURE)?.values?.get(0))
    52	    }
    53	}
    54	
    55	/** DEMO only: impact >=25 m/s², then >=1 s quiet at 9.81±1 within 3 s.
    56	 * At least 6 quiet samples; gaps >250 ms, invalid or reversed times break evidence.
    57	 * These illustrative thresholds are not a validated fall detector.
    58	 */
    59	class DemoDetector {
    60	    private var last: Long? = null
    61	    private var impact: Long? = null
    62	    private var quiet: Long? = null
    63	    private var count = 0
    64	    fun reset() { last = null; impact = null; quiet = null; count = 0 }
    65	    fun accept(p: PhoneSensorPacket): Boolean {
    66	        val t = p.timestampNs
    67	        val a = listOf(p.accelXMs2, p.accelYMs2, p.accelZMs2)
    68	        if (t < 0 || a.any { !it.isFinite() }) { reset(); return false }
    69	        val previous = last
    70	        if (previous != null && (t <= previous || t - previous > 250_000_000)) {
    71	            reset(); last = t; return false
    72	        }
    73	        last = t
    74	        val magnitude = sqrt(a.sumOf { it.toDouble() * it.toDouble() })
    75	        if (magnitude >= 25) { impact = t; quiet = null; count = 0; return false }
    76	        val hit = impact ?: return false
    77	        if (t - hit > 3_000_000_000L) { impact = null; quiet = null; count = 0; return false }
    78	        if (abs(magnitude - 9.81) > 1) { quiet = null; count = 0; return false }
    79	        if (quiet == null) quiet = t
    80	        count++
    81	        if (count >= 6 && t - quiet!! >= 1_000_000_000) { reset(); return true }
    82	        return false
    83	    }
    84	}
    85	class DemoReplay(private val startMs: Long) {
    86	    private var index = 0
    87	    val finished get() = index > 16
    88	    fun due(nowMs: Long): List<PhoneSensorPacket> {
    89	        val result = mutableListOf<PhoneSensorPacket>()
    90	        while (!finished && nowMs >= startMs && nowMs - startMs >= index * 100L) {
    91	            result += PhoneSensorPacket((startMs + index * 100L) * 1_000_000, 0,
    92	                0f, 0f, if (index == 2) 30f else 9.81f)
    93	            index++
    94	        }
    95	        return result
    96	    }
    97	}
    98	class LocalDemoSink : AlertSink {
    99	    var fail = false
   100	    private val received = ArrayDeque<Alert>()
   101	    override fun send(alert: Alert) {
   102	        if (fail) error("Lỗi mô phỏng")
   103	        received.addLast(alert)
   104	        while (received.size > 32) received.removeFirst()
   105	    }
   106	    fun alerts() = received.toList()
   107	}
   108	class DemoSession(clock: MonotonicClock, val sink: LocalDemoSink = LocalDemoSink()) {
   109	    private val core = AlertCore(clock, sink)
   110	    private val detector = DemoDetector()
   111	    fun resetDetection() = detector.reset()
   112	    fun accept(packet: PhoneSensorPacket) {
   113	        if (core.snapshot().state == State.MONITORING && detector.accept(packet)) {
   114	            core.suspected(); core.evidenceConfirmed()
   115	        }
   116	    }
   117	    fun snapshot() = core.snapshot()
   118	    fun events() = core.events()
   119	    fun tick() = core.tick()
   120	    fun safe() { core.safe(); detector.reset() }
   121	    fun needHelp() { core.needHelp(); detector.reset() }
   122	    fun complete() { core.complete(); detector.reset() }
   123	}
   124	class SosHold {
   125	    private var started: Long? = null
   126	    fun start(nowMs: Long) { started = nowMs }
   127	    fun cancel() { started = null }
   128	    fun ready(nowMs: Long): Boolean {
   129	        val start = started ?: return false
   130	        if (nowMs >= start && nowMs - start >= 2000) { cancel(); return true }
   131	        return false
   132	    }
   133	}
