    39	        collector = PhoneSensorCollector(this, controller::acceptPhone)
    40	        setContent {
    41	            MaterialTheme(colorScheme = if (isSystemInDarkTheme()) darkColorScheme() else lightColorScheme()) {
    42	                DemoScreen(controller, sensorSummary)
    43	            }
